{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin",
  "version": "2.3.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "generate": "bun script/icon-name.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/promise/index.d.ts",
      "import": "./dist/promise/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    },
    "./gui": {
      "types": "./dist/gui/index.d.ts",
      "import": "./dist/gui/index.js"
    },
    "./gui/main": {
      "types": "./dist/gui/main.d.ts",
      "import": "./dist/gui/main.js"
    },
    "./gui/host": null,
    "./gui/builtin": null,
    "./gui/file": {
      "types": "./dist/gui/file.d.ts",
      "import": "./dist/gui/file.js"
    },
    "./gui/review": {
      "types": "./dist/gui/review.d.ts",
      "import": "./dist/gui/review.js"
    },
    "./gui/browser": {
      "types": "./dist/gui/browser.d.ts",
      "import": "./dist/gui/browser.js"
    },
    "./gui/updater": null,
    "./gui/vite": {
      "types": "./dist/gui/vite.d.ts",
      "import": "./dist/gui/vite.js"
    },
    "./gui/*": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "imports": {
    "#plugin-source": {
      "bun": "./dist/source.bun.js",
      "node": "./dist/source.node.js",
      "default": "./dist/source.node.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode/ai": "2.3.0",
    "@opencode/client": "2.3.0",
    "@opencode/protocol": "2.3.0",
    "@opencode/schema": "2.3.0",
    "@opencode/util": "2.3.0",
    "effect": "4.1.0"
  },
  "peerDependencies": {
    "@opencode/theme": "2.3.0",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "electron": "*",
    "solid-js": ">=1.9.0",
    "vite": ">=6",
    "vite-plugin-solid": ">=2.11"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@types/node": "24.12.2",
    "electron": "44.9.1",
    "solid-js": "1.9.17",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10",
    "@typescript/native": "npm:typescript@7.1.0-beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin"
  }
}
