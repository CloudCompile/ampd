{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/client",
  "version": "2.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/promise/index.d.ts",
      "import": "./dist/promise/index.js"
    },
    "./promise": {
      "types": "./dist/promise/index.d.ts",
      "import": "./dist/promise/index.js"
    },
    "./promise/api": {
      "types": "./dist/promise/api.d.ts",
      "import": "./dist/promise/api.js"
    },
    "./service": {
      "types": "./dist/promise/service.d.ts",
      "import": "./dist/promise/service.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js"
    },
    "./effect/api": {
      "types": "./dist/effect/api.d.ts",
      "import": "./dist/effect/api.js"
    },
    "./effect/service": {
      "types": "./dist/effect/service.d.ts",
      "import": "./dist/effect/service.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "generate": "bun run script/generate.ts",
    "check:generated": "bun run generate && git diff --exit-code -- src/promise/generated src/effect/generated src/effect/api",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/schema": "2.3.0",
    "@opencode/protocol": "2.3.0"
  },
  "peerDependencies": {
    "effect": "4.1.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@opencode/httpapi-codegen": "2.3.0",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "4.1.0",
    "solid-js": "1.9.17"
  }
}
